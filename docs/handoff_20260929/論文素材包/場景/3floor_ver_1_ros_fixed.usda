    def OmniGraph "ROS_Clock"
    {
        custom token evaluationMode = "Automatic"
        custom token evaluator:type = "execution"
        custom token fabricCacheBacking = "StageWithoutHistory"
        custom int2 fileFormatVersion = (1, 9)
        custom token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "on_playback_tick"
        {
            custom token node:type = "omni.graph.action.OnPlaybackTick"
            custom int node:typeVersion = 1
        }

        def OmniGraphNode "isaac_read_simulation_time"
        {
            custom token node:type = "isaacsim.core.nodes.IsaacReadSimulationTime"
            custom int node:typeVersion = 1
        }

        def OmniGraphNode "ros2_publish_clock"
        {
            custom uint inputs:execIn
            uint inputs:execIn.connect = </World/ROS_Clock/on_playback_tick.outputs:tick>
            custom double inputs:timeStamp
            double inputs:timeStamp.connect = </World/ROS_Clock/isaac_read_simulation_time.outputs:simulationTime>
            custom string inputs:topicName = "clock"
            custom token node:type = "isaacsim.ros2.bridge.ROS2PublishClock"
            custom int node:typeVersion = 1
        }
    }
}

