#usda 1.0
(
    subLayers = [
        @/home/aa/Ros/charge_rl/assets/3F/3floor_ver_1.usd@
    ]
)

over "World"
{
    over "charger_rover4_5_0"
    {
        quatf xformOp:orient = (-0.017701223, -1.3554652e-20, -4.3374885e-19, 0.9998433)
        double3 xformOp:translate = (0.33316419609739617, -1.7170889059246455, -0.19160448820952797)

        over "charger_rover_urdf5"
        {
            over "transform_tree_odometry"
            {
                over "ros2_publish_odometry"
                {
                    custom string inputs:chassisFrameId = "base_footprint"
                    custom string inputs:odomFrameId = "odom"
                    custom double inputs:timeStamp
                    double inputs:timeStamp.connect = </World/charger_rover4_5_0/charger_rover_urdf5/transform_tree_odometry/isaac_read_simulation_time.outputs:simulationTime>
                    custom string inputs:topicName = "/odom_gt"
                }

                over "ros2_publish_raw_transform_tree"
                {
                    custom uint inputs:execIn
                    uint inputs:execIn.connect = None
                    custom string inputs:topicName = "/isaac_tf_disabled"
                }

                over "tf_tree_base_link_to_sensors"
                {
                    custom uint inputs:execIn
                    uint inputs:execIn.connect = None
                    custom string inputs:topicName = "/isaac_tf_disabled"
                }

                over "tf_tree_base_link_to_wheel_base"
                {
                    custom uint inputs:execIn
                    uint inputs:execIn.connect = None
                    custom string inputs:topicName = "/isaac_tf_disabled"
                }

                over "tf_tree_base_link_to_base_footprint"
                {
                    custom uint inputs:execIn
                    uint inputs:execIn.connect = None
                    custom string inputs:topicName = "/isaac_tf_disabled"
                }
            }

            over "velodyne_01"
            {
                over "ros2_publish_point_cloud"
                {
                    custom string inputs:frameId = "velodyne_link"
                    custom double inputs:timeStamp
                    double inputs:timeStamp.connect = </World/charger_rover4_5_0/charger_rover_urdf5/velodyne_01/isaac_read_simulation_time.outputs:simulationTime>
                    custom string inputs:topicName = "/velodyne_points_ideal"
                }
            }

            over "chassis_imu"
            {
                over "ros2_publish_imu"
                {
                    custom string inputs:frameId = "imu_link"
                }
            }

            over "ros_lidars"
            {
                over "publish_front_2d_lidar_scan"
                {
                    custom bool inputs:enabled = 0
                    custom uint inputs:execIn
                    uint inputs:execIn.connect = None
                    custom string inputs:frameId = "ydlidar_front_link"
                }

                over "publish_back_2d_lidar_scan"
                {
                    custom bool inputs:enabled = 0
                    custom uint inputs:execIn
                    uint inputs:execIn.connect = None
                    custom string inputs:frameId = "ydlidar_back_link"
                }

                over "front_2d_lidar_render_product"
                {
                    custom bool inputs:enabled = 0
                    custom uint inputs:execIn
                    uint inputs:execIn.connect = None
                }

                over "back_2d_lidar_render_product"
                {
                    custom bool inputs:enabled = 0
                    custom uint inputs:execIn
                    uint inputs:execIn.connect = None
                }

                over "isaac_run_one_simulation_frame"
                {
                    custom uint inputs:execIn
                    uint inputs:execIn.connect = None
                }
            }

            over "velodyne"
            {
                double3 xformOp:translate = (0.003693200143232614, -0.000002302795443204066, 1.3009369579615273)

                over "Lidar"
                {
                    float maxRange = 40
                }
            }

            over "differential_drive"
            {
                over "differential_controller"
                {
                    custom double inputs:maxAcceleration = 1.2
                    custom double inputs:maxAngularSpeed = 1.2
                    custom double inputs:maxDeceleration = 1.2
                    custom double inputs:maxLinearSpeed = 1.5
                    custom double inputs:wheelDistance = 0.559212
                    custom double inputs:wheelRadius = 0.131847
                }
            }

            over "velodyne_base_mount_joint"
            {
                point3f physics:localPos0 = (-0.02000006, 1.5487963e-9, 1.29634)
            }
        }
    }

